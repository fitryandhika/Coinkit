# ============================================
# TAHAP 1 — Market data publik, TIDAK butuh API key.
# ============================================
BITGET_API_BASE_URL=https://api.bitget.com

# ============================================
# TAHAP 6 — Database (Supabase, gratis). Service role key HANYA dipakai server-side.
# Buat project di supabase.com, jalankan db/schema.sql di SQL Editor, lalu isi:
# ============================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk scheduler eksternal (mis. cron-job.org) memanggil worker lebih sering
# dari batas 1x/hari Vercel Cron di plan Hobby. Isi string acak sendiri (contoh: openssl rand -hex 16).
WORKER_SECRET=

# Catatan: CRON_SECRET TIDAK perlu diisi manual — otomatis di-generate & di-set Vercel
# saat kamu deploy project yang punya vercel.json berisi "crons".

# ============================================
# Disiapkan untuk tahap trading API mendatang. JANGAN diisi/dipakai sekarang.
# ============================================
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
